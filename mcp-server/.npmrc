# Mirrors the root .npmrc (see issue #74). Config is read from the install cwd, and this
# package has its own lockfile and is installed with `cd mcp-server && pnpm install`, so
# the root file does not apply here. Without this, the MCP server was the one dependency
# tree in the repo installing with no supply-chain quarantine at all.

# Quarantine newly-published packages for 7 days (10080 minutes).
minimum-release-age=10080

# Block transitive deps from using non-registry specifiers (git:, github:, tarball URLs).
block-exotic-subdeps=true

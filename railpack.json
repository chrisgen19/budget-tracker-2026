{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "24"
  },
  "steps": {
    "build": {
      "commands": [
        "pnpm build:deploy",
        "cp -r .next/static .next/standalone/.next/static",
        "cp -r public .next/standalone/public"
      ]
    }
  },
  "deploy": {
    "startCommand": "node .next/standalone/server.js",
    "aptPackages": ["openssl"],
    "variables": {
      "HOSTNAME": "0.0.0.0",
      "PORT": "3000"
    }
  }
}

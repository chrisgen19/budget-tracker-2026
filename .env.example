DATABASE_URL="postgres://myuser:mypassword@localhost:5432/budgettracker-nextjs"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3111"

# Resend (email verification + password reset)
RESEND_API_KEY=""
EMAIL_FROM="Budget Tracker <noreply@yourdomain.com>"

# Google Gemini (receipt scanning OCR)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Fallback model tried once when GEMINI_MODEL stays overloaded (503) after retries.
# Set to "" to disable fallback.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
# Thinking for receipt scans — the right knob depends on the model generation.
# Defaults favor extraction quality; switch to "speed mode" (budget 0 / level
# minimal) for ~3x faster scans at the cost of reasoning on tricky receipts.
# Gemini 2.x (thinkingBudget): -1 = dynamic thinking (default, best quality),
#   0 = off (fastest), 128-24576 = fixed token budget
GEMINI_THINKING_BUDGET="-1"
# Gemini 3+ (thinkingLevel): minimal (fastest) | low | medium (default, best quality) | high
GEMINI_THINKING_LEVEL="medium"
# Per-attempt timeout in ms — overloaded attempts can hang 40-70s before failing;
# aborting early lets retries/fallback kick in sooner. 0 disables the timeout.
# Default is generous for thinking-enabled scans; lower it (e.g. 30000) in speed mode.
GEMINI_TIMEOUT_MS="60000"

# Cron job authentication — shared with the GitHub Actions workflow that triggers
# /api/cron/bill-reminders daily on production. Set the same value in the deploy
# environment and in the repo's Actions secrets.
CRON_SECRET=""

# Max AI Assessment report generations per user per day (manual generate/refresh).
# Optional; defaults to 10. The grounded report makes 2 Gemini calls per generation,
# so this caps cost; cached reports and the daily tip don't count against it.
AI_ASSESSMENT_DAILY_LIMIT="10"

# --- Telegram bot (optional, personal use) -----------------------------------
# The bot logs transactions and answers summary queries from a chat. It is an MCP
# client, not a database client: it calls /api/mcp with a scoped token, so it holds
# no database credentials and inherits the token scope, the write lease, the rate
# limit and the audit trail.

# Starts the bot from src/instrumentation.ts on server boot. Set this ONLY in the
# deployed environment. Telegram answers a second concurrent getUpdates for one bot
# token with 409 Conflict, so enabling it locally while production runs the bot makes
# the two fight and both misbehave. Leave it false or unset on a development machine.
TELEGRAM_BOT_ENABLED="false"

# From @BotFather.
TELEGRAM_BOT_TOKEN=""

# Blank counts as unset for every TELEGRAM_ value below, so an empty field falls back
# to the documented default rather than to an empty string or a zero offset.

# Who may talk to the bot. With neither set the bot serves nobody and says so at
# startup: bot usernames are searchable and the t.me link is public, so without a
# list any stranger could read your balances and write transactions.
# Numeric ids are permanent and unforgeable and are the ones to use. Usernames are a
# convenience and are weaker, because a released handle can be claimed by someone
# else, who would inherit access. Message the bot once and its id is logged.
TELEGRAM_ALLOWED_IDS=""
TELEGRAM_ALLOWED_USERNAMES=""

# Where the bot writes. Mint the token in Profile > MCP Access with the
# transactions:write scope AND budget:read: every free-text message reads the category
# list before it can log anything, so a write-only token fails on every message. Give
# the bot its own rather than sharing one with another client, so revoking it does not
# break both.
# Required, no default. Point it at the /api/mcp of whichever app the bot should write
# to. Three cases, and the ports differ:
#   local, with pnpm dev + pnpm telegram:bot   -> http://localhost:3111/api/mcp
#   in the deployed container (BOT_ENABLED)    -> http://localhost:3000/api/mcp
#   local bot writing to production            -> https://your-domain/api/mcp
# The value below is the local-development one, since this file is a template for .env.
# In the container the app listens on 3000 (next start), and localhost is right there:
# no DNS, no TLS, no external hop.
TELEGRAM_MCP_URL="http://localhost:3111/api/mcp"
TELEGRAM_MCP_TOKEN=""

# Display only, for chat replies. The server owns every amount; this changes nothing
# about what is stored. Defaults to the peso sign.
TELEGRAM_CURRENCY_SYMBOL=""

# Required, no default. Minutes, getTimezoneOffset() convention, so UTC+8 is -480, and
# it must match the account's own timezone. It used to fall back to the host's offset,
# which is UTC inside the app container, so "yesterday" silently resolved to the wrong
# day. Every query and write is still resolved server-side against
# users.timezone_offset, so a wrong value here cannot move a stored row.
TELEGRAM_TZ_OFFSET="-480"

# Only for a network whose DNS sinkholes Telegram: an address to use for
# api.telegram.org instead of asking the resolver. Leave unset everywhere else.
# Telegram rotates these, so a stale value here breaks all bot traffic even when DNS
# works perfectly.
TELEGRAM_API_IP=""

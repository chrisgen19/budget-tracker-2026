generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  ADMIN
  FREE
  PAID
}

enum BillFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ANNUALLY
  CUSTOM
}

enum BillOccurrenceStatus {
  PAID
  SKIPPED
  SNOOZED
}

enum DayNameFormat {
  FULL
  SHORT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AiInsightKind {
  REPORT
  DAILY_TIP
}

/// Lifecycle of a single receipt scan attempt.
/// PENDING is the in-flight reservation that makes the quota check atomic;
/// only PENDING and SUCCESS consume a monthly credit. FAILED rows are kept
/// (not deleted) so a refunded attempt still counts against the rate limit.
/// How a transaction came to exist. Provenance is a column rather than a label because labels
/// are a spending dimension here: `getLabelBreakdown` splits a transaction's amount evenly across
/// its labels, so tagging provenance would divert half of every MCP-written expense out of its
/// real category. A label is also user-deletable, and an audit marker the actor can erase is not
/// an audit marker.
enum TransactionSource {
  APP
  MCP
  TELEGRAM
}

enum ScanStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         UserRole      @default(FREE)
  hideAmounts             Boolean       @default(false) @map("hide_amounts")
  currency                String        @default("PHP")
  quickExpenseCategories  String[]      @default([]) @map("quick_expense_categories")
  quickIncomeCategories   String[]      @default([]) @map("quick_income_categories")
  quickLabels             String[]      @default([]) @map("quick_labels")
  emailVerified           Boolean       @default(false) @map("email_verified")
  receiptScanEnabled      Boolean       @default(false) @map("receipt_scan_enabled")
  transactionLayout       String        @default("infinite") @map("transaction_layout")
  transactionAmountAutofocus Boolean    @default(true) @map("transaction_amount_autofocus")
  defaultLabelType           String     @default("EXPENSE") @map("default_label_type")
  showDayName                Boolean    @default(true) @map("show_day_name")
  dayNameFormat              DayNameFormat @default(SHORT) @map("day_name_format")
  emailBillReminders         Boolean    @default(false) @map("email_bill_reminders")
  /// Whether the Telegram bot sends one evening prompt on weekdays asking what was spent on the
  /// commute and lunch. Separate from `emailBillReminders` in every way: different channel,
  /// different cron route, different log table. A bill is a known amount on a known date; this is
  /// a nudge about spending that has already happened and was not written down.
  telegramDailyPrompt        Boolean    @default(false) @map("telegram_daily_prompt")
  /// When to send it, "HH:mm" in the user's own timezone, compared lexicographically the same way
  /// `LabelSchedule.startTime` is.
  ///
  /// Data rather than a cron expression on purpose. Coolify tasks run in the container, which is
  /// UTC, so 20:00 Asia/Manila is 12:00 UTC and a weekday there is not reliably a weekday here.
  /// Encoding that in a dashboard field puts the schedule somewhere no test can reach.
  telegramDailyPromptTime    String     @default("20:00") @map("telegram_daily_prompt_time")
  /// The Telegram account permitted to act as this user through the Mini App.
  ///
  /// The bot needs no such link: it writes through an MCP token already bound to a user. A Mini
  /// App cannot use that token, because the page runs in a browser and a credential shipped to a
  /// client is a leaked credential, so identity has to come from the signed `initData` instead --
  /// and that carries a Telegram id, which nothing here previously resolved to an account.
  ///
  /// Unique so two app users cannot claim one Telegram account. Nullable and set by hand
  /// (`scripts/link-telegram-user.ts`): a linking UI is a whole flow for a one-off, and leaving it
  /// null is the correct state for every account that does not use Telegram.
  ///
  /// Note this is *not* sufficient on its own. `getTelegramUserId` also requires the id to be in
  /// `TELEGRAM_ALLOWED_IDS`, so revoking access there revokes it for the Mini App too.
  telegramUserId          String?       @unique @map("telegram_user_id")
  timezoneOffset          Int           @default(-480) @map("timezone_offset")
  /// Lease, not a flag: MCP writes are permitted only while this is in the future. A boolean
  /// would depend on remembering to switch it back off, and the failure that matters is leaving
  /// writes on for days, which fails silently. Null means writes are off.
  mcpWritesEnabledUntil   DateTime?     @map("mcp_writes_enabled_until")
  transactions            Transaction[]
  categories              Category[]
  scanLogs                ScanLog[]
  scheduledTransactions   ScheduledTransaction[]
  verificationTokens      VerificationToken[]
  labels                  Label[]
  aiAssessments           AiAssessment[]
  aiUsageLogs             AiUsageLog[]
  mcpTokens               McpToken[]
  telegramPromptLogs      TelegramPromptLog[]
  telegramQuickTiles      TelegramQuickTile[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

/// A long-lived bearer credential for the remote MCP endpoint at `/api/mcp`.
///
/// Only the SHA-256 of the token is stored, never the token. SHA-256 rather than bcrypt on
/// purpose: the secret is 256 bits of CSPRNG output, not a guessable password, so there is
/// nothing for a slow KDF to defend against, and every request has to look the row up *by*
/// the digest, which a salted hash cannot do without reading and comparing every row.
model McpToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the user called it, e.g. "Claude Desktop (laptop)". Only for telling tokens apart.
  name            String
  /// Leading characters of the plaintext, kept so the UI can identify a token it can never show again.
  prefix          String
  tokenHash       String    @unique @map("token_hash")
  scopes          String[]
  /// What this token represents, stamped onto every row it writes as `transactions.created_via`.
  ///
  /// Provenance belongs to the credential, not the endpoint. Every remote write arrives through
  /// `/api/mcp`, so deriving it from the endpoint made a Telegram bot's rows claim Claude wrote
  /// them. Set at mint time and never from request input, so a compromised token cannot pretend
  /// to be something else.
  source          TransactionSource @default(MCP)
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  lastUsedAt      DateTime? @map("last_used_at")
  /// Fixed-window rate limit counters, updated in one atomic UPDATE per request.
  ///
  /// `rateWindowStart` must hold UTC, because `consumeRateLimit` compares it against
  /// `now() AT TIME ZONE 'UTC'`. Prisma supplies `@default(now())` from the client as a correctly
  /// bound UTC timestamp, so always create these rows through Prisma. The column's SQL-level
  /// `DEFAULT CURRENT_TIMESTAMP` is Prisma's own generated convention and resolves to the
  /// *session* zone, so a raw `INSERT` that omits this column would start the window hours in the
  /// future and keep the token throttled long past the window. Changing that default by hand is
  /// not the fix: `prisma migrate diff` then reports permanent drift and regenerates it back.
  rateWindowStart DateTime  @default(now()) @map("rate_window_start")
  rateCount       Int       @default(0) @map("rate_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("mcp_tokens")
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  icon         String
  color        String
  isDefault    Boolean         @default(false) @map("is_default")
  userId       String?         @map("user_id")
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]
  telegramQuickTiles    TelegramQuickTile[]
  createdAt    DateTime        @default(now()) @map("created_at")

  // NOTE: this constraint does NOT cover defaults. Their userId is NULL, and Postgres treats
  // NULLs as distinct in a unique index, so the same default could be inserted twice. A partial
  // unique index on (name, type) WHERE user_id IS NULL closes that (migration
  // 20260828100000_unique_default_categories). Prisma cannot express a partial index, so the DB
  // constraint is authoritative; do not assume this line is the whole story.
  @@unique([name, type, userId])
  @@map("categories")
}

model Transaction {
  id               String          @id @default(cuid())
  amount           Float
  description      String
  type             TransactionType
  date             DateTime
  categoryId       String          @map("category_id")
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptGroupId   String?                @map("receipt_group_id")
  receiptBreakdown Json?                  @map("receipt_breakdown")
  /// Idempotency key for POST /api/transactions/batch. A batch that commits but whose
  /// response is lost looks identical to one that never ran, and the review modal invites
  /// the user to retry — which would post the same receipts a second time.
  clientBatchId    String?                @map("client_batch_id")
  /// Which surface created this row. Set server-side, never from caller input, so a compromised
  /// MCP token cannot forge or omit it.
  createdVia       TransactionSource      @default(APP) @map("created_via")
  /// Which MCP token wrote this row, when `createdVia` is MCP. Deliberately not a foreign key:
  /// the audit record has to outlive the credential, and revoking or deleting a token must not
  /// cascade away the evidence of what it did.
  mcpTokenId       String?                @map("mcp_token_id")
  /// Which surface last *edited* this row. Null means it has not been edited since this column
  /// existed, which is honest for every backfilled row; a default of APP would assert an edit
  /// that never happened. Deliberately separate from `createdVia`, which describes creation and
  /// must not be falsified by an edit: a row typed into the app and later corrected over MCP is
  /// both APP-created and MCP-edited, and one column cannot say that. Set server-side, never
  /// from caller input.
  updatedVia       TransactionSource?     @map("updated_via")
  /// Which MCP token last edited this row, when `updatedVia` is MCP or TELEGRAM. Not a foreign
  /// key, for the same reason `mcpTokenId` is not: revoking or deleting a credential must not
  /// cascade away the evidence of what it did.
  updatedByMcpTokenId String?              @map("updated_by_mcp_token_id")
  billId           String?                @map("bill_id")
  bill             ScheduledTransaction?  @relation(fields: [billId], references: [id], onDelete: SetNull)
  labels           TransactionLabel[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([userId, type])
  @@index([receiptGroupId])
  @@index([billId])
  @@index([userId, clientBatchId])
  @@index([userId, createdVia])
  @@index([userId, updatedVia])
  @@map("transactions")
}

model AppSettings {
  id                 String   @id @default(cuid())
  role               UserRole @unique
  receiptScanEnabled Boolean  @default(false) @map("receipt_scan_enabled")
  maxUploadFiles     Int      @default(10) @map("max_upload_files")
  monthlyScanLimit   Int      @default(0) @map("monthly_scan_limit")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model ScanLog {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ScanStatus @default(SUCCESS)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@map("scan_logs")
}

model AiAssessment {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        AiInsightKind
  periodKey   String        @map("period_key")
  content     Json
  sources     Json?
  model       String
  generatedAt DateTime      @default(now()) @map("generated_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([userId, kind, periodKey])
  @@index([userId])
  @@map("ai_assessments")
}

model AiUsageLog {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AiInsightKind
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model ScheduledTransaction {
  id                  String          @id @default(cuid())
  amount              Float
  description         String          @default("")
  type                TransactionType
  frequency           BillFrequency
  customIntervalDays  Int?            @map("custom_interval_days")
  reminderDaysBefore  Int             @default(0) @map("reminder_days_before")
  /// Whether this bill's cost varies month to month -- a metered utility rather than a fixed
  /// contract. `amount` stays required and keeps working as a fallback, but for a variable bill
  /// the reminder asserts no figure and the forecast derives one from the payments already
  /// linked to this bill. A single constant cannot describe a cost that swings 2.7x (#217).
  isVariable          Boolean         @default(false) @map("is_variable")
  startDate           DateTime        @map("start_date")
  endDate             DateTime?       @map("end_date")
  nextDueDate         DateTime        @map("next_due_date")
  isActive            Boolean         @default(true) @map("is_active")
  categoryId          String          @map("category_id")
  category            Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId              String          @map("user_id")
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences         ScheduledTransactionLog[]
  emailLogs           BillEmailLog[]
  transactions        Transaction[]
  labels              BillLabel[]
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([userId, nextDueDate])
  @@index([userId, isActive])
  @@map("scheduled_transactions")
}

model ScheduledTransactionLog {
  id                      String                @id @default(cuid())
  scheduledTransactionId  String                @map("scheduled_transaction_id")
  scheduledTransaction    ScheduledTransaction  @relation(fields: [scheduledTransactionId], references: [id], onDelete: Cascade)
  dueDate                 DateTime              @map("due_date")
  status                  BillOccurrenceStatus
  actionDate              DateTime?             @map("action_date")
  transactionId           String?               @map("transaction_id")
  snoozeUntil             DateTime?             @map("snooze_until")
  createdAt               DateTime              @default(now()) @map("created_at")

  @@index([scheduledTransactionId, dueDate])
  @@index([scheduledTransactionId, status])
  @@map("scheduled_transaction_logs")
}

model BillEmailLog {
  id                      String               @id @default(cuid())
  scheduledTransactionId  String               @map("scheduled_transaction_id")
  scheduledTransaction    ScheduledTransaction @relation(fields: [scheduledTransactionId], references: [id], onDelete: Cascade)
  dueDate                 DateTime             @map("due_date")
  sentAt                  DateTime             @default(now()) @map("sent_at")

  @@unique([scheduledTransactionId, dueDate])
  @@index([scheduledTransactionId])
  @@map("bill_email_logs")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

model Label {
  id           String             @id @default(cuid())
  name         String
  color        String
  applicableTo String             @default("BOTH") @map("applicable_to")
  userId       String             @map("user_id")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionLabel[]
  bills        BillLabel[]
  quickTiles   TelegramQuickTileLabel[]
  schedules    LabelSchedule[]
  createdAt    DateTime           @default(now()) @map("created_at")

  // NOTE: The actual DB index uses LOWER(name) for case-insensitive uniqueness
  // (see migration 20260405120000). Prisma doesn't support expression indexes,
  // so this @@unique is kept for ORM awareness but the DB constraint is authoritative.
  @@unique([name, userId])
  @@map("labels")
}

model LabelSchedule {
  id        String   @id @default(cuid())
  labelId   String   @map("label_id")
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  days      Int[]
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([labelId])
  @@map("label_schedules")
}

model TransactionLabel {
  id            String      @id @default(cuid())
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  labelId       String      @map("label_id")
  label         Label       @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([transactionId, labelId])
  @@index([transactionId])
  @@index([labelId])
  @@map("transaction_labels")
}

model BillLabel {
  id                      String               @id @default(cuid())
  scheduledTransactionId  String               @map("scheduled_transaction_id")
  scheduledTransaction    ScheduledTransaction @relation(fields: [scheduledTransactionId], references: [id], onDelete: Cascade)
  labelId                 String               @map("label_id")
  label                   Label                @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt               DateTime             @default(now()) @map("created_at")

  @@unique([scheduledTransactionId, labelId])
  @@index([scheduledTransactionId])
  @@index([labelId])
  @@map("bill_labels")
}

/// One row per day the evening Telegram prompt was sent, so a re-run cannot send it twice.
///
/// The cron fires every 15 minutes and the prompt is due once a day, so something has to make the
/// send idempotent. A read-then-filter would race two overlapping ticks; the unique constraint
/// cannot. Same shape and same reasoning as `BillEmailLog`.
model TelegramPromptLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The user's local calendar day, encoded at UTC midnight. Date-only, meaning "the 5th" for
  /// everyone, exactly like a bill due date - never converted back through a timezone on read.
  promptedOn DateTime @map("prompted_on")
  sentAt     DateTime @default(now()) @map("sent_at")

  @@unique([userId, promptedOn])
  @@map("telegram_prompt_logs")
}

/// One button in the Telegram Mini App's quick-log grid: a routine expense whose description and
/// category are already decided, so logging it costs a tap instead of a sentence.
///
/// This is `QUICK_FARES` (`src/lib/telegram/quick-keyboard.ts`) made into data. That file names the
/// point at which the trade flips - "storing them per user means a column, an editor and a settings
/// page, which is most of the work this whole approach exists to avoid" - and a Mini App *is* the
/// editor, so the editor stops being an additional cost. The reply keyboard itself stays: it is
/// zero latency and needs no webview.
///
/// A table rather than a `Json` column on `users`, and rather than the `String[]` of ids the
/// quick-pick preferences use. Both were considered and both fail the same two ways. They hold a
/// category id nothing enforces, which is the defect `quickPickIdsSchema` papers over and
/// `scripts/prune-quick-category-ids.ts` cleans up after. And they have no per-row identity, so
/// renaming or deleting one button means rewriting the whole array, and two edits in flight lose
/// one. The `Json` precedent that does exist - `transactions.receipt_breakdown` - is the opposite
/// case: a derived snapshot attached to one row, never edited on its own.
model TelegramQuickTile {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the button reads. Kept short: the grid is three columns on a phone.
  label       String
  /// What is written to `transactions.description`.
  ///
  /// Separate from `label` because the two are read in different places at different times.
  /// "Office" is a good button and a useless ledger entry a year later.
  description String
  /// The amount a tap logs, or NULL to ask for one on the numeric pad.
  ///
  /// NULL *is* the "ask" state. A separate `kind` enum beside this was considered and rejected:
  /// it states the same fact twice, and two statements of one fact can disagree - a FIXED tile
  /// with no amount is unloggable and an ASK tile with one is a lie about what the button does.
  /// Nullable rather than 0, because a zero-amount transaction is a real thing to write by
  /// accident and nothing downstream would flag it.
  amount      Float?
  /// Almost always EXPENSE, but it has to travel with `categoryId`: `categoriesAreUsable` refuses
  /// a category whose type disagrees with the item's, so a tile carrying one without the other
  /// would fail at the write rather than at the edit.
  type        TransactionType @default(EXPENSE)
  /// Where this tile files, or NULL to let `matchCategory` decide from `description` at log time.
  ///
  /// `SetNull` is deliberately neither rule already in this file. `Transaction.category` is
  /// `Restrict`, because a transaction with no category is meaningless; `User` is `Cascade`,
  /// because the row belongs to them. A button is neither: deleting a category must not delete
  /// the buttons that referenced it, which would read as data loss from an unrelated action, and
  /// must not be blocked by them either. So the tile survives and the log path falls back, which
  /// is what the shorthand path has always done.
  categoryId  String?  @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Labels pinned to this button, applied to every transaction it logs.
  ///
  /// A pin **overrides** auto-apply schedules for that tap: `createTransactionBatch` reads an
  /// explicit `labelIds` as an opt-out from schedule matching, and that is the wanted reading
  /// here. The user named these labels on this button; a schedule guessing over a named label
  /// moves money in `getLabelBreakdown`, which splits an amount across whatever a row carries.
  /// A tile with no pins omits the field entirely - never `[]` - so schedules run as before.
  labels      TelegramQuickTileLabel[]
  /// Sparse (10, 20, 30...) so one tile can be moved without rewriting every other row.
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Two buttons reading the same thing are indistinguishable in a grid, and a mis-tap between
  /// them is invisible. A duplicate is refused with a named cause, not accepted silently.
  @@unique([userId, label])
  @@index([userId, sortOrder])
  @@map("telegram_quick_tiles")
}

/// A label pinned to a quick-log button.
///
/// `Cascade` on both sides, matching `TransactionLabel` and `BillLabel`, and deliberately *not*
/// the `SetNull` the tile's own `categoryId` uses. The two are not the same case: a deleted
/// category must leave the button working, because the log path has a documented fallback ladder
/// (`resolveTileCategory`) to land it somewhere sensible. A deleted label has no fallback and
/// nothing to fall back *to* - the pin simply stops existing and the button reverts to whatever
/// the user's schedules would have done anyway, which is the behaviour it had before it was
/// pinned.
model TelegramQuickTileLabel {
  id        String            @id @default(cuid())
  tileId    String            @map("tile_id")
  tile      TelegramQuickTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
  labelId   String            @map("label_id")
  label     Label             @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([tileId, labelId])
  @@index([tileId])
  @@index([labelId])
  @@map("telegram_quick_tile_labels")
}
